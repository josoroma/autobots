{
  "input": {
    "$defs": {
      "CronjobSchedule": {
        "additionalProperties": false,
        "description": "Every `minutes`, or `daily` at a wall-clock `time` (`HH:MM`) in the routine's timezone.",
        "properties": {
          "kind": {
            "enum": [
              "interval",
              "daily"
            ],
            "title": "Kind",
            "type": "string"
          },
          "minutes": {
            "anyOf": [
              {
                "maximum": 527040,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Minutes"
          },
          "time": {
            "anyOf": [
              {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time"
          }
        },
        "required": [
          "kind"
        ],
        "title": "CronjobSchedule",
        "type": "object"
      },
      "CronjobTask": {
        "additionalProperties": false,
        "description": "What a routine starts, and when. An Expert's goal, or a published workflow version.",
        "properties": {
          "target_kind": {
            "enum": [
              "expert",
              "workflow"
            ],
            "title": "Target Kind",
            "type": "string"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          },
          "target_version": {
            "minimum": 1,
            "title": "Target Version",
            "type": "integer"
          },
          "schedule": {
            "$ref": "#/$defs/CronjobSchedule"
          },
          "timezone": {
            "default": "America/Costa_Rica",
            "maxLength": 64,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          },
          "goal": {
            "default": "",
            "maxLength": 20000,
            "title": "Goal",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Inputs",
            "type": "object"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tools"
          },
          "limit_micro_usd": {
            "default": 1000000,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Limit Micro Usd",
            "type": "integer"
          }
        },
        "required": [
          "target_kind",
          "target_id",
          "target_version",
          "schedule"
        ],
        "title": "CronjobTask",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "list",
          "create",
          "update",
          "pause",
          "resume",
          "run",
          "remove"
        ],
        "title": "Action",
        "type": "string"
      },
      "routine_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Routine Id"
      },
      "name": {
        "anyOf": [
          {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Name"
      },
      "expected_version": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Version"
      },
      "task": {
        "anyOf": [
          {
            "$ref": "#/$defs/CronjobTask"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "action"
    ],
    "title": "CronjobInput",
    "type": "object"
  },
  "output": {
    "$defs": {
      "CronjobRoutine": {
        "additionalProperties": false,
        "properties": {
          "routine_id": {
            "format": "uuid",
            "title": "Routine Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "latest_version": {
            "title": "Latest Version",
            "type": "integer"
          }
        },
        "required": [
          "routine_id",
          "name",
          "enabled",
          "latest_version"
        ],
        "title": "CronjobRoutine",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "`status` is `listed`, `saved`, `paused`, `resumed`, `removed`, or for `run` one of\n`admitted`, `skipped_overlap` and `blocked`, with `reason` saying why it wasn't admitted.",
    "properties": {
      "action": {
        "enum": [
          "list",
          "create",
          "update",
          "pause",
          "resume",
          "run",
          "remove"
        ],
        "title": "Action",
        "type": "string"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "routine_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Routine Id"
      },
      "version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Version"
      },
      "run_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Run Id"
      },
      "reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "routines": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/CronjobRoutine"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Routines"
      }
    },
    "required": [
      "action",
      "status"
    ],
    "title": "CronjobOutput",
    "type": "object"
  }
}
