# Server-only. Leave empty to configure OpenRouter through the app; inference needs a key.
# Never put a real key here or in a NEXT_PUBLIC_ variable.
OPENROUTER_API_KEY=

# Optional: the GitHub issue connector (Decision 0007). A fine-grained token limited to this one repository.
AUTOBOTS_GITHUB_ISSUES_REPOSITORY=
AUTOBOTS_GITHUB_ISSUES_TOKEN=
