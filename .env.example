# Server-only. Leave empty to configure OpenRouter through the app; inference needs a key.
# Never put a real key here or in a NEXT_PUBLIC_ variable.
OPENROUTER_API_KEY=

# Optional tool-provider keys (Decision 0017). Each enables only its own tools, and is read by the
# worker per attempt. Set them for the worker and the API. `make start` passes TAVILY_API_KEY,
# JINA_API_KEY and SERPAPI_API_KEY from this file to the install's API and worker, and nothing else
# from it. A key saved in Settings → Keys & vars wins over this file for its workspace (Decisions
# 0024, 0025 and 0032).
# tavily_search, tavily_extract, tavily_map and tavily_crawl:
TAVILY_API_KEY=

# Optional: the GitHub issue connector (Decision 0007). A fine-grained token limited to this one repository,
# never a broader developer token that happens to be exported under this name. `make start` passes both, and
# a token or repository saved in Settings → Keys & vars wins for its workspace (Decision 0025).
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# browse_goal (US-14.12): set to `enabled` only after scripts/qualify_browser_executor.py passes.
# `make start` passes it to the install's API and worker when it is exactly `enabled` (Decision 0024 K7).
AUTOBOTS_BROWSER_EXECUTOR=enabled

# search_web and extract_website_content:
JINA_API_KEY=

# google_search, Google through SerpApi (Decision 0032), which the Google bot Expert uses:
SERPAPI_API_KEY=

OWNER_EMAIL=
OWNER_PASSWORD=