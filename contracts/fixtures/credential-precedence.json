[
  {
    "name": "nothing configured",
    "mode": "development",
    "process": {},
    "files": {},
    "expected": null
  },
  {
    "name": "process environment wins over every file",
    "mode": "development",
    "process": {
      "OPENROUTER_API_KEY": "from-process"
    },
    "files": {
      ".env.development.local": "OPENROUTER_API_KEY=a",
      ".env.local": "OPENROUTER_API_KEY=b",
      ".env.development": "OPENROUTER_API_KEY=c",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": "process_environment",
      "value": "from-process"
    }
  },
  {
    "name": "mode local file is second",
    "mode": "development",
    "process": {},
    "files": {
      ".env.development.local": "OPENROUTER_API_KEY=a",
      ".env.local": "OPENROUTER_API_KEY=b",
      ".env.development": "OPENROUTER_API_KEY=c",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env.development.local",
      "value": "a"
    }
  },
  {
    "name": "env local is third",
    "mode": "development",
    "process": {},
    "files": {
      ".env.local": "OPENROUTER_API_KEY=b",
      ".env.development": "OPENROUTER_API_KEY=c",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env.local",
      "value": "b"
    }
  },
  {
    "name": "mode file is fourth",
    "mode": "production",
    "process": {},
    "files": {
      ".env.production": "OPENROUTER_API_KEY=c",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env.production",
      "value": "c"
    }
  },
  {
    "name": "plain file is last",
    "mode": "development",
    "process": {},
    "files": {
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env",
      "value": "d"
    }
  },
  {
    "name": "test mode skips env local",
    "mode": "test",
    "process": {},
    "files": {
      ".env.local": "OPENROUTER_API_KEY=b",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env",
      "value": "d"
    }
  },
  {
    "name": "test mode still reads its own local file",
    "mode": "test",
    "process": {},
    "files": {
      ".env.test.local": "OPENROUTER_API_KEY=t",
      ".env.local": "OPENROUTER_API_KEY=b"
    },
    "expected": {
      "source": ".env.test.local",
      "value": "t"
    }
  },
  {
    "name": "whitespace in the process environment is absent",
    "mode": "development",
    "process": {
      "OPENROUTER_API_KEY": "   "
    },
    "files": {
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env",
      "value": "d"
    }
  },
  {
    "name": "whitespace in a higher file is absent",
    "mode": "development",
    "process": {},
    "files": {
      ".env.local": "OPENROUTER_API_KEY=\"   \"",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env",
      "value": "d"
    }
  },
  {
    "name": "an empty entry is absent",
    "mode": "development",
    "process": {},
    "files": {
      ".env.local": "OPENROUTER_API_KEY=",
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": ".env",
      "value": "d"
    }
  },
  {
    "name": "an all-whitespace configuration is absent",
    "mode": "development",
    "process": {
      "OPENROUTER_API_KEY": " "
    },
    "files": {
      ".env": "OPENROUTER_API_KEY=  "
    },
    "expected": null
  },
  {
    "name": "a nonempty bad higher value is returned, not skipped",
    "mode": "development",
    "process": {
      "OPENROUTER_API_KEY": "not usable"
    },
    "files": {
      ".env": "OPENROUTER_API_KEY=d"
    },
    "expected": {
      "source": "process_environment",
      "value": "not usable"
    }
  },
  {
    "name": "surrounding whitespace is trimmed",
    "mode": "development",
    "process": {
      "OPENROUTER_API_KEY": "  padded  "
    },
    "files": {},
    "expected": {
      "source": "process_environment",
      "value": "padded"
    }
  },
  {
    "name": "quotes, export and comments",
    "mode": "development",
    "process": {},
    "files": {
      ".env": "# comment\nexport OPENROUTER_API_KEY=\"quoted value\"\nOTHER=x\n"
    },
    "expected": {
      "source": ".env",
      "value": "quoted value"
    }
  },
  {
    "name": "single quotes",
    "mode": "development",
    "process": {},
    "files": {
      ".env": "OPENROUTER_API_KEY='single'"
    },
    "expected": {
      "source": ".env",
      "value": "single"
    }
  },
  {
    "name": "a trailing comment",
    "mode": "development",
    "process": {},
    "files": {
      ".env": "OPENROUTER_API_KEY=value # note"
    },
    "expected": {
      "source": ".env",
      "value": "value"
    }
  },
  {
    "name": "another variable does not count",
    "mode": "development",
    "process": {
      "OTHER": "x"
    },
    "files": {
      ".env": "NEXT_PUBLIC_OPENROUTER_API_KEY=x"
    },
    "expected": null
  }
]
