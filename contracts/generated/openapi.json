{
  "components": {
    "schemas": {
      "BudgetCounters": {
        "additionalProperties": false,
        "properties": {
          "limit_micro_usd": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Limit Micro Usd",
            "type": "integer"
          },
          "reserved_micro_usd": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Reserved Micro Usd",
            "type": "integer"
          },
          "spent_micro_usd": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Spent Micro Usd",
            "type": "integer"
          }
        },
        "required": [
          "spent_micro_usd",
          "reserved_micro_usd",
          "limit_micro_usd"
        ],
        "title": "BudgetCounters",
        "type": "object"
      },
      "CredentialDraft": {
        "additionalProperties": false,
        "description": "Transient. It is validated and encrypted, and never returned, logged or echoed.",
        "properties": {
          "draft_key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Draft Key",
            "type": "string"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "draft_key",
          "expected_version"
        ],
        "title": "CredentialDraft",
        "type": "object"
      },
      "EffectiveRolePolicy": {
        "additionalProperties": false,
        "properties": {
          "bindings": {
            "items": {
              "$ref": "#/components/schemas/RoleBinding"
            },
            "title": "Bindings",
            "type": "array"
          },
          "role_policy_version": {
            "title": "Role Policy Version",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "role_policy_version",
          "bindings"
        ],
        "title": "EffectiveRolePolicy",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExpectedVersion": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "ExpectedVersion",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelAvailability": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "canonical_id": {
            "title": "Canonical Id",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ModelProfileId"
          },
          "wire_id": {
            "title": "Wire Id",
            "type": "string"
          }
        },
        "required": [
          "profile",
          "canonical_id",
          "wire_id",
          "available"
        ],
        "title": "ModelAvailability",
        "type": "object"
      },
      "ModelList": {
        "additionalProperties": false,
        "properties": {
          "catalog_status": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ],
            "title": "Catalog Status",
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelAvailability"
            },
            "title": "Models",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "catalog_status",
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ModelPolicyState": {
        "additionalProperties": false,
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/EffectiveRolePolicy"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "version",
          "policy"
        ],
        "title": "ModelPolicyState",
        "type": "object"
      },
      "ModelPolicyUpdate": {
        "additionalProperties": false,
        "description": "Not strict, so JSON strings become enums. Unknown fields and values are still refused.",
        "properties": {
          "default_profile": {
            "$ref": "#/components/schemas/ModelProfileId"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "role_overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelProfileId"
            },
            "title": "Role Overrides",
            "type": "object"
          }
        },
        "required": [
          "expected_version",
          "default_profile",
          "role_overrides"
        ],
        "title": "ModelPolicyUpdate",
        "type": "object"
      },
      "ModelProfileId": {
        "enum": [
          "openrouter_deepseek_flash",
          "openrouter_astra"
        ],
        "title": "ModelProfileId",
        "type": "string"
      },
      "ModelRole": {
        "enum": [
          "coordinator",
          "router",
          "planner",
          "executor",
          "researcher",
          "coder",
          "reviewer",
          "evaluator",
          "summarizer",
          "memory_curator",
          "skill_learner",
          "tool_repair",
          "workflow_generator",
          "general_purpose"
        ],
        "title": "ModelRole",
        "type": "string"
      },
      "ProviderStatus": {
        "additionalProperties": false,
        "description": "Source, authentication, catalog and qualification are independent facts, MP-04.",
        "properties": {
          "auth_status": {
            "enum": [
              "missing",
              "configured",
              "invalid",
              "unavailable"
            ],
            "title": "Auth Status",
            "type": "string"
          },
          "catalog_status": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ],
            "title": "Catalog Status",
            "type": "string"
          },
          "credential_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Id"
          },
          "credential_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Version"
          },
          "provider": {
            "const": "openrouter",
            "title": "Provider",
            "type": "string"
          },
          "qualification_status": {
            "const": "not_qualified",
            "title": "Qualification Status",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "settings_version": {
            "title": "Settings Version",
            "type": "integer"
          },
          "source": {
            "enum": [
              "none",
              "app",
              "environment"
            ],
            "title": "Source",
            "type": "string"
          },
          "validated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validated At"
          }
        },
        "required": [
          "schema_version",
          "provider",
          "settings_version",
          "source",
          "auth_status",
          "catalog_status",
          "qualification_status",
          "credential_id",
          "credential_version",
          "validated_at"
        ],
        "title": "ProviderStatus",
        "type": "object"
      },
      "RoleBinding": {
        "additionalProperties": false,
        "properties": {
          "canonical_id": {
            "title": "Canonical Id",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ModelProfileId"
          },
          "role": {
            "$ref": "#/components/schemas/ModelRole"
          },
          "wire_id": {
            "title": "Wire Id",
            "type": "string"
          }
        },
        "required": [
          "role",
          "profile",
          "canonical_id",
          "wire_id"
        ],
        "title": "RoleBinding",
        "type": "object"
      },
      "RunEvent": {
        "additionalProperties": false,
        "description": "The sanitized public envelope from SP-011. Payloads are typed, so nothing raw can pass.",
        "properties": {
          "causal_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Causal Ids",
            "type": "array"
          },
          "occurred_at": {
            "format": "date-time",
            "pattern": "^.+(Z|[+-]00:00)$",
            "title": "Occurred At",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/RunStatusChanged"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sequence": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "run_id",
          "sequence",
          "causal_ids",
          "occurred_at",
          "payload"
        ],
        "title": "RunEvent",
        "type": "object"
      },
      "RunIntentCheck": {
        "additionalProperties": false,
        "description": "Whether model-backed work could proceed. It creates no run and calls no model.",
        "properties": {
          "code": {
            "enum": [
              "ready",
              "credentials_required",
              "credential_invalid",
              "credential_unavailable"
            ],
            "title": "Code",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "ready",
          "code"
        ],
        "title": "RunIntentCheck",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "waiting_input",
          "waiting_approval",
          "paused",
          "verifying",
          "cancelling",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunStatusChanged": {
        "additionalProperties": false,
        "properties": {
          "current": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "previous": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "type": {
            "const": "run.status_changed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "previous",
          "current"
        ],
        "title": "RunStatusChanged",
        "type": "object"
      },
      "RunSummary": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/BudgetCounters"
          },
          "created_at": {
            "format": "date-time",
            "pattern": "^.+(Z|[+-]00:00)$",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parent_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Run Id"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "updated_at": {
            "format": "date-time",
            "pattern": "^.+(Z|[+-]00:00)$",
            "title": "Updated At",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "id",
          "workspace_id",
          "parent_run_id",
          "status",
          "created_at",
          "updated_at",
          "budget"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "ServiceHealth": {
        "additionalProperties": false,
        "description": "Liveness only. Holds no address, version or secret.",
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status"
        ],
        "title": "ServiceHealth",
        "type": "object"
      },
      "SessionSummary": {
        "additionalProperties": false,
        "description": "Who the verified session is, and the workspaces membership grants it.",
        "properties": {
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "workspace_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Workspace Ids",
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "user_id",
          "workspace_ids"
        ],
        "title": "SessionSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "id"
        ],
        "title": "WorkspaceSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Autobots Agent API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Internal"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "getModels",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Internal"
            }
          },
          {
            "in": "header",
            "name": "x-autobots-workspace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Workspace"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Models"
      }
    },
    "/v1/runs/intent": {
      "post": {
        "description": "Only a user's Run click reaches this. It admits nothing: run admission is a later story.",
        "operationId": "checkRunIntent",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Internal"
            }
          },
          {
            "in": "header",
            "name": "x-autobots-workspace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Workspace"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunIntentCheck"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Run Intent"
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "getSession",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Internal"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session"
      }
    },
    "/v1/settings/model-policy": {
      "put": {
        "operationId": "putModelPolicy",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Internal"
            }
          },
          {
            "in": "header",
            "name": "x-autobots-workspace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Autobots-Workspace"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPolicyUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelPolicyState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Model Policy"
      }
    },
    "/v1/settings/model-providers": {
      "get": {
        "operationId": "getModelProviders",
        "parameters": [
          {
            "in": "header",
            "name": "x-autobots-internal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
